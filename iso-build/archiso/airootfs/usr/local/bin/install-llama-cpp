#!/bin/bash
# 编译 llama.cpp（RTX 2060 CUDA 7.5 优化）
set -e
echo "==> 安装编译依赖 (gcc make cmake cuda)..."
pacman -S --needed gcc make cmake cuda --noconfirm
LLAMA_DIR=/opt/llama.cpp
if [ ! -d "$LLAMA_DIR" ]; then
  git clone --depth 1 https://github.com/ggml-org/llama.cpp "$LLAMA_DIR"
fi
cd "$LLAMA_DIR"
echo "==> CUDA 编译 (架构 7.5 = Turing / RTX 2060)..."
cmake -S . -B build -DGGML_CUDA=ON -DCMAKE_BUILD_TYPE=Release -DCMAKE_CUDA_ARCHITECTURES="7.5"
cmake --build build --config Release -j"$(nproc)"
echo ""
echo "llama.cpp 编译完成"
echo "  用法: $LLAMA_DIR/build/bin/llama-cli -m model.gguf -ngl 33 -t 4"
echo "  模型下载(8B Q4_K_M, ~4.9GB):"
echo "  wget https://huggingface.co/bartowski/Meta-Llama-3-8B-Instruct-GGUF/resolve/main/Meta-Llama-3-8B-Instruct-Q4_K_M.gguf"
