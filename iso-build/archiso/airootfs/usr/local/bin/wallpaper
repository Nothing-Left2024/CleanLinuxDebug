#!/bin/sh
# 动态壁纸管理（仅图形模式）
case "$1" in
  start)
    pkill -f "mpv.*cleanlinux" 2>/dev/null || true
    if [ -f /usr/share/wallpapers/cleanlinux.mp4 ]; then
      mpv --config /root/.config/mpv/cleanlinux.conf /usr/share/wallpapers/cleanlinux.mp4 &
      echo "动态壁纸已启动"
    else
      echo "未找到 /usr/share/wallpapers/cleanlinux.mp4，请放入 MP4 文件"
    fi
    ;;
  stop) pkill -f "mpv.*cleanlinux" 2>/dev/null && echo "已停止" || echo "未在运行" ;;
  list) ls /usr/share/wallpapers/ 2>/dev/null ;;
  *) echo "用法: wallpaper [start|stop|list]" ;;
esac
