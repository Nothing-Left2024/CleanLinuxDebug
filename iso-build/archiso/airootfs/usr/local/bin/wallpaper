#!/bin/sh
# 动态壁纸管理（仅图形模式）
WALL="/usr/share/wallpapers"
case "$1" in
  start)
    pkill -f "mpv.*-fullscreen" 2>/dev/null || true
    VIDEO="$(ls "$WALL"/*.mp4 2>/dev/null | head -1)"
    if [ -n "$VIDEO" ]; then
      mpv --no-border --no-osc --no-osd-bar --loop --volume=0 --fullscreen "$VIDEO" &
      echo "动态壁纸已启动: $VIDEO"
    else
      echo "$WALL 下没有 .mp4 文件，请放入视频后重试"
    fi
    ;;
  stop) pkill -f "mpv.*-fullscreen" 2>/dev/null && echo "已停止" || echo "未在运行" ;;
  list) ls "$WALL"/ 2>/dev/null ;;
  *) echo "用法: wallpaper [start|stop|list]" ;;
esac
