#!/bin/bash
# 安装/更新 NVIDIA 驱动（RTX 2060: CUDA 7.5）
set -e
echo "==> 安装 NVIDIA 专有驱动 (nvidia-dkms)..."
pacman -S --needed nvidia-dkms nvidia-utils nvidia-settings opencl-nvidia --noconfirm
cat > /etc/modprobe.d/nvidia.conf << 'EON'
options nvidia_drm modeset=1
EON
modprobe nvidia_drm 2>/dev/null || true
echo ""
echo "NVIDIA 驱动安装完成"
echo "  GPU: GeForce RTX 2060 (TU106, 6GB GDDR6)"
echo "  验证: nvidia-smi"
