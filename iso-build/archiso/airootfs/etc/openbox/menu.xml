<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/menu">
  <menu id="root-menu" label="CleanLinux">
    <item label="终端 (Alacritty)">
      <action name="Execute"><command>alacritty</command></action>
    </item>
    <separator label="CleanLinux 工具"/>
    <item label="功能编辑器 (开关功能省内存)">
      <action name="Execute"><command>cleanlinux-features</command></action>
    </item>
    <item label="系统监控 (显存/内存仪表盘)">
      <action name="Execute"><command>cleanlinux-monitor</command></action>
    </item>
    <item label="进程管理 (lxtask)">
      <action name="Execute"><command>lxtask</command></action>
    </item>
    <item label="GPU 详情 (nvtop)">
      <action name="Execute"><command>alacritty -e nvtop</command></action>
    </item>
    <item label="应用启动器 (dmenu)">
      <action name="Execute"><command>dmenu_run</command></action>
    </item>
    <separator label="安装与驱动"/>
    <item label="文本安装器 (archinstall)">
      <action name="Execute"><command>alacritty -e archinstall</command></action>
    </item>
    <item label="安装 NVIDIA 驱动">
      <action name="Execute"><command>alacritty -e /bin/sh -c 'install-nvidia; read -p "按回车关闭..."'</command></action>
    </item>
    <item label="编译 llama.cpp (CUDA)">
      <action name="Execute"><command>alacritty -e /bin/sh -c 'install-llama-cpp; read -p "按回车关闭..."'</command></action>
    </item>
    <item label="系统菜单 (文本)">
      <action name="Execute"><command>alacritty -e cleanlinux-menu</command></action>
    </item>
    <separator label="系统"/>
    <item label="磁盘管理 (GParted)">
      <action name="Execute"><command>gparted</command></action>
    </item>
    <separator/>
    <item label="重启">
      <action name="Restart"/>
    </item>
    <item label="关机">
      <action name="Exit"/>
    </item>
  </menu>
</openbox_menu>
